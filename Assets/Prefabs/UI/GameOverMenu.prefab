--- !u!114 &8212703408422187635
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3649842020920842874}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb74d60062104422bce2eb9d8c8509ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Project.GameOverMenu
  _winTitles:
  - "\u0412\u043E\u0442 \u0438 \u0433\u043E\u043E\u043E\u043E\u043B!"
  - "\u041F\u043E\u0431\u0435\u0434\u0430!"
  - "\u0423\u0440\u0430\u0430\u0430\u0430!"
  - "\u0411\u0415\u0415\u0415\u0415\u0415\u041C!"
  - "\u041F\u0435\u0440\u0435\u043C\u043E\u0433\u0430!"
  - "\u041F\u0435\u0440\u0435\u043C\u043E\u0433\u0430!"
  _winDescriptions:
  - "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B\n\u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436
    \u0438 \u0436\u0435\u043C\u0447\u0443\u0436\u0438\u043D\u0430!"
  - "\u041E\u0442\u043A\u0440\u044B\u0442\u044B \u043D\u043E\u0432\u044B\u0435 \u0448\u0442\u0443\u043A\u0438!
    \n\u041F\u0440\u0438\u043A\u043E\u043B\u044C\u043A\u043E, \u0434\u0430?"
  - "\u041D\u0430\u0433\u0440\u0430\u0434\u0430 \u0432\u0432\u0435\u0440\u0445\u0443\n\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E!"
  - "\u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C
    \u0432\u043E\u0442 \u0454\u0442\u043E.\n\u041A\u0430\u0444\u043A\u0430 \u0433\u043E\u0440\u0434\u0438\u0442\u0441\u044F
    \u0442\u043E\u0431\u043E\u0439"
  - "\u0425\u043E\u0442\u044C \u0433\u0434\u0435-\u0442\u043E \u043F\u043E\u0431\u0435\u0434\u0430,\n\u0424\u0430\u043A\u0438\u043D
    \u0432\u0435\u0440\u0434\u0436\u0438\u043D"
  - "\u0425\u043E\u0442\u044C \u0433\u0434\u0435-\u0442\u043E \u043F\u043E\u0431\u0435\u0434\u0430,\n\u0424\u0430\u043A\u0438\u043D
    \u0432\u0435\u0440\u0434\u0436\u0438\u043D"
  _loseTitles:
  - "\u0415\u0441\u0442\u044C \u043F\u0440\u043E\u0431\u0438\u0442\u0438\u0435!"
  - "\u0420\u0430\u0437\u0431\u0435\u0441\u0438\u043B\u0438 \u0434\u043E\u043C\u0438\u0432\u043A\u0443"
  - "\u0424\u0410\u0410\u0410\u041A \u044E \u043C\u0438\u043D!"
  - "\u0423\u0431\u0435\u0436\u0438\u0449\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435\u0442 T_T"
  - "\u041F\u0440\u043E\u0432\u0430\u043B o_O"
  - "\u041F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043E ^_^"
  - "\u041F\u043E\u0445\u0443\u0439 \u043F\u0440\u043E\u0435\u0431\u0430\u043B\u0438"
  _loseDescriptions:
  - "\u041D\u0443. \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u0447\u0442\u043E
    \u043D\u0435 \u041C\u0430\u043A\u0441\u0438\u043C..."
  - "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0435\u0449\u0435 \u0440\u0430\u0437"
  - "\u0412\u0421\u0422\u0410\u0412\u0410\u0419"
  - "\u0415\u0449\u0435 \u0440\u0430\u043D\u043E \u0441\u0434\u0430\u0432\u0430\u0442\u044C\u0441\u044F"
  - " \u041E\u0427\u0415\u041D\u042C, \n\u041E\u0427\u0415\u041D\u042C \n\u0418\u041D\u0422\u0415\u0420\u0415\u0421\u041D\u041E..."
  - "\u041F\u043E\u0445\u0443\u0439 \u043F\u0440\u043E\u0435\u0431\u0430\u043B\u0438"
  - "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430:\n\u0421\u0442\u0430\u0440\u0430\u0439\u0441\u044F
    \u043B\u0443\u0447\u0448\u0435"
  - "\u0421\u043E\u0432\u0435\u0442:\n\u041D\u0435 \u0438\u0433\u0440\u0430\u0439
    \u0442\u0430\u043A"
  - "\u0423\u0434\u0430\u0447\u0438 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
    \u0440\u0430\u0437..."
  - "\u041A\u0430\u043A\u0430\u044F \u0454\u0442\u043E \u043F\u043E\u043F\u044B\u0442\u043A\u0430?"
  - "\u041E\u043A\u0435\u0439 \u0454\u0442\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u043E
    \u043A\u0440\u0438\u043D\u0436..."
  _titleText: {fileID: 2290817591423672456}
  _descriptionText: {fileID: 9053252930968469588}
